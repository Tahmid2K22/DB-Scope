{
  "name": "db-scope",
  "displayName": "DB-Scope: ImpactLens for Databases",
  "description": "AI-powered database lifecycle platform — impact analysis, real-time SQL diagnostics, schema merge conflict resolution, and duplicate detection.",
  "version": "0.1.0",
  "publisher": "db-scope-team",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "database",
    "sql",
    "migration",
    "schema",
    "postgresql",
    "mysql",
    "oracle"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/*.sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbscope.analyzeBlastRadius",
        "title": "DB-Scope: Analyze Migration Impact"
      },
      {
        "command": "dbscope.detectDuplicates",
        "title": "DB-Scope: Detect Logical Duplicates in Schema"
      },
      {
        "command": "dbscope.mergeDatabases",
        "title": "DB-Scope: Analyze Database Merge Conflicts"
      },
      {
        "command": "dbscope.fetchContext",
        "title": "DB-Scope: Fetch Database Context from Codebase"
      },
      {
        "command": "dbscope.openDashboard",
        "title": "DB-Scope: Open Dashboard"
      },
      {
        "command": "dbscope.showHistory",
        "title": "DB-Scope: Show Schema Evolution Timeline"
      },
      {
        "command": "dbscope.exportAnalysis",
        "title": "DB-Scope: Export Impact Analysis to JSON"
      }
    ],
    "configuration": {
      "title": "DB-Scope",
      "properties": {
        "dbscope.connectionString": {
          "type": "string",
          "default": "",
          "description": "Database connection string (postgresql://user:pass@host:port/db)"
        },
        "dbscope.dbType": {
          "type": "string",
          "enum": [
            "postgresql",
            "mysql",
            "oracle"
          ],
          "default": "postgresql",
          "description": "Database type"
        },
        "dbscope.riskThreshold": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 10,
          "description": "Risk score threshold (1-10) above which to block migrations"
        },
        "dbscope.autoFetchContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fetch database context from codebase on workspace open"
        },
        "dbscope.diagnosticsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time SQL diagnostics and warnings"
        },
        "dbscope.watsonxUrl": {
          "type": "string",
          "default": "https://us-south.ml.cloud.ibm.com",
          "description": "IBM watsonx.ai region URL (e.g. https://us-south.ml.cloud.ibm.com)"
        },
        "dbscope.watsonxApiKey": {
          "type": "string",
          "default": "",
          "description": "IBM Cloud API key for watsonx.ai authentication (required for AI-powered analysis)"
        },
        "dbscope.watsonxProjectId": {
          "type": "string",
          "default": "",
          "description": "watsonx.ai project ID found in the IBM Cloud project URL"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbscope-sidebar",
          "title": "DB-Scope",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dbscope-sidebar": [
        {
          "id": "dbscope.dashboardView",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "dbscope.analyzeBlastRadius",
          "when": "editorLangId == sql",
          "group": "dbscope"
        },
        {
          "command": "dbscope.detectDuplicates",
          "when": "editorLangId == sql",
          "group": "dbscope"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node test/member1.run.test.js && node test/member2.run.test.js && node src/mergeAnalyzer/mergeAnalyzer.test.js",
    "test:member1": "node test/member1.run.test.js",
    "test:member2": "node test/member2.run.test.js",
    "test:member3": "node src/mergeAnalyzer/mergeAnalyzer.test.js",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "package": "vsce package"
  },
  "dependencies": {
    "mysql2": "^3.6.5",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
